# Copy to .env; docker compose and the dev profile (application-dev.yml) both read it. Values are taken literally,
# so do not quote them. These match the dev defaults; never reuse them outside local development.
DB_PORT=5433
DB_OWNER_USER=wallet_owner
DB_OWNER_PASSWORD=wallet_owner_dev
DB_APP_USER=wallet_app
DB_APP_PASSWORD=wallet_app_dev
# Administrator created on startup (dev profile defaults shown); use a strong password anywhere else
ADMIN_EMAIL=admin@wallet.local
ADMIN_PASSWORD=admin-dev-password
# Encrypts authenticator app secrets (dev default shown); generate another with `openssl rand -base64 32`
TWO_FACTOR_ENCRYPTION_KEY=ZGV2LW9ubHktdHdvLWZhY3Rvci1rZXktMzItYnl0ZXM=
# Password Prometheus sends to scrape metrics from the management port; docker/observability/prometheus/prometheus.yml
# has the same one, so change both together
MANAGEMENT_SCRAPE_PASSWORD=scrape-dev-password
# Emails are real, sent through Gmail (smtp.gmail.com:587 by default). MAIL_PASSWORD is a 16-character app password
# without spaces (https://myaccount.google.com/apppasswords, needs two-step verification), never the account
# password. Gmail sends from MAIL_USERNAME whatever EMAIL_FROM says; only its display name is kept.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=
EMAIL_FROM=Digital Wallet <you@gmail.com>
