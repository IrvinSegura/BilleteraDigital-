# Copy to .env; docker compose reads it automatically.
# These values match the dev defaults in application-dev.yml. If you change them, export the same
# variables in your IDE run configuration too. Never reuse them outside local development.
DB_PORT=5433
DB_OWNER_USER=wallet_owner
DB_OWNER_PASSWORD=wallet_owner_dev
DB_APP_USER=wallet_app
DB_APP_PASSWORD=wallet_app_dev
